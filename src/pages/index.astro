---
import BaseHead from "../components/BaseHead.astro";
import Terminal from "../components/Terminal.astro";
import Footer from "../components/Footer.astro";
import ThemeInit from "../components/ThemeInit.astro";
import Graph3D from "../components/Graph3D.astro";
import "../styles/terminal.css";
import { getCollection } from "astro:content";
import { SITE_TITLE, SITE_DESCRIPTION, PROFILE, EDUCATION } from "../consts";

const projectEntries = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);
const skillEntries = (await getCollection("skills")).sort((a, b) => a.data.order - b.data.order);
const experienceEntries = (await getCollection("experience")).sort(
  (a, b) => a.data.order - b.data.order,
);

const PROJECTS = projectEntries.map((e) => ({ id: e.id, ...e.data }));
const SKILLS = skillEntries.map((e) => e.data);
const EXPERIENCE = experienceEntries.map((e) => e.data);

const terminalProjects = PROJECTS.map((p) => ({
  id: p.id,
  title: p.title,
  company: p.company,
  metrics: p.metrics ?? "",
}));
const skillCats = SKILLS.map((s) => s.category);

const siteUrl = Astro.site?.toString() ?? "https://dathxspace.cloud/";
const personJsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: PROFILE.name,
  jobTitle: PROFILE.role,
  address: { "@type": "PostalAddress", addressLocality: PROFILE.location },
  email: `mailto:${PROFILE.email}`,
  telephone: PROFILE.phone,
  url: siteUrl,
  knowsAbout: SKILLS.map((s) => s.category),
};
// ItemList of projects — gives each shipped system its own entity for SEO.
const projectsJsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Projects by Dat Xuan Huynh",
  numberOfItems: PROJECTS.length,
  itemListElement: PROJECTS.map((p, i) => ({
    "@type": "ListItem",
    position: i + 1,
    url: `${siteUrl}#${p.id}`,
    item: {
      "@type": "SoftwareSourceCode",
      name: p.title,
      description: p.blurb,
      programmingLanguage: p.stack,
      ...(p.metrics ? { comment: p.metrics } : {}),
    },
  })),
};
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={SITE_TITLE}
      description={SITE_DESCRIPTION}
      image="/og-image.png"
      imageWidth={1200}
      imageHeight={630}
    />
    <ThemeInit />
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link
      rel="preload"
      href="/fonts/source-serif-4-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${PROFILE.name} — projects feed`}
      href={new URL("rss.xml", Astro.site)}
    />
    <script type="application/ld+json" set:html={JSON.stringify(personJsonLd)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(projectsJsonLd)}></script>
  </head>
  <body class="term">
    <a class="term-skip" href="#main">
      Skip to content
    </a>
    <a class="term-skip" href="#term-input">
      Skip to terminal input
    </a>

    <header class="nav-term">
      <nav class="nav-term__line" aria-label="Sections">
        <span class="prompt">&gt;</span> dathx{" "}
        <a href="#work" data-spy="work">
          --projects
        </a>{" "}
        <a href="#skills" data-spy="skills">
          --skills
        </a>{" "}
        <a href="#experience" data-spy="experience">
          --experience
        </a>{" "}
        <a href="#contact" data-spy="contact">
          --contact
        </a>{" "}
        <button type="button" id="theme-btn" class="theme-btn" aria-label="Cycle color theme">
          theme:light
        </button>
        <span class="nav-term__caret" aria-hidden="true">
          ▮
        </span>
      </nav>
    </header>

    <section class="graph-hero" aria-labelledby="hero-h">
      <h1 class="visually-hidden" id="hero-h">
        {PROFILE.name} — {PROFILE.role}
      </h1>
      <Graph3D
        profile={{ name: PROFILE.name, role: PROFILE.role }}
        projects={PROJECTS.map((p) => ({
          id: p.id,
          title: p.title,
          company: p.company,
          period: p.period,
          metrics: p.metrics,
          stack: p.stack,
        }))}
        skills={SKILLS}
        experience={EXPERIENCE}
      />
      <a class="graph-hero__down" href="#shell" aria-label="Scroll to terminal">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="M5 9l7 7 7-7"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </a>
    </section>

    <main id="main" class="term-wrap">
      <section class="term-hero hero-boot" id="shell" aria-label="Terminal">
        <Terminal projects={terminalProjects} skillCats={skillCats} expCount={EXPERIENCE.length} />
        <div class="term-actions">
          <a class="tlink btn-primary" href={`mailto:${PROFILE.email}`}>
            Email me →
          </a>
          <button class="chip" type="button" data-copy={PROFILE.email}>
            Copy email
          </button>
          <a class="tlink" href="#work">
            Read the work →
          </a>
        </div>
      </section>

      <section class="term-section reveal" style="--i: 1" id="work" aria-labelledby="work-h">
        <h2 id="work-h">
          <span class="p">$</span> cat projects/*.md
        </h2>
        <p class="term-section__note">
          {PROJECTS.length} shipped systems. Each block carries its stack and the one number that
          matters — all measured, none invented.
        </p>
        <div class="play-grid">
          {PROJECTS.map((p) => (
            <article class="play-block" id={p.id}>
              <div class="play-block__head">
                <h3>{p.title}</h3>
              </div>
              <p class="play-block__id">
                {p.id} · {p.company} · {p.period}
              </p>
              {p.metrics && <p class="play-block__metrics">{p.metrics}</p>}
              <p class="play-block__blurb">{p.blurb}</p>
              <ul class="play-block__stack">
                {p.stack.map((s) => (
                  <li>{s}</li>
                ))}
              </ul>
              <button class="chip" type="button" data-copy={p.stack.join(", ")}>
                Copy stack
              </button>
            </article>
          ))}
        </div>
      </section>

      <section
        class="term-section term-section--tight reveal"
        style="--i: 2"
        id="skills"
        aria-labelledby="skills-h"
      >
        <h2 id="skills-h">
          <span class="p">$</span> lshw --short
        </h2>
        <p class="term-section__note">Capability inventory, grouped the way clients buy it.</p>
        <table class="spec">
          <caption>{SKILLS.length}groups, from silicon to dashboard.</caption>
          <tbody>
            {SKILLS.map((s) => (
              <tr>
                <th scope="row">{s.category}</th>
                <td>{s.items.join(", ")}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </section>

      <section
        class="term-section term-section--tight reveal"
        style="--i: 3"
        id="experience"
        aria-labelledby="exp-h"
      >
        <h2 id="exp-h">
          <span class="p">$</span> history --work
        </h2>
        <p class="term-section__note">Four roles, 2022 to present.</p>
        <ol class="steps">
          {EXPERIENCE.map((j, i) => (
            <li>
              <span class="steps__n">0{i + 1}</span>
              <div>
                <p class="steps__role">{j.role}</p>
                <p class="steps__co">
                  {j.company} · {j.period}
                </p>
                <ul class="steps__items">
                  {j.items.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </div>
            </li>
          ))}
        </ol>
        <p class="term-section__note">
          {EDUCATION.degree} — {EDUCATION.school} · {EDUCATION.period} · GPA {EDUCATION.gpa}
        </p>
      </section>

      <section
        class="term-section term-section--tight reveal"
        style="--i: 4"
        id="contact"
        aria-labelledby="contact-h"
      >
        <h2 id="contact-h">
          <span class="p">$</span> ./hire-me --now
        </h2>
        <p class="term-lede">
          Embedded sensing, real-time video, edge AI, or the infrastructure underneath — one email
          starts it. Replies within 48 hours.
        </p>
        <div class="term-actions">
          <a class="tlink btn-primary" href={`mailto:${PROFILE.email}`}>
            Email me →
          </a>
          <button class="chip" type="button" data-copy={PROFILE.email}>
            Copy email
          </button>
          <a class="tlink" href={`tel:${PROFILE.phone.replace(/\s/g, "")}`}>
            Call {PROFILE.phone} →
          </a>
        </div>
      </section>
    </main>

    <Footer />

    <a href="#main" class="to-top" id="to-top" aria-label="Back to top">
      ↑
    </a>
    <div id="toast" class="toast" role="status" aria-live="polite" aria-hidden="true"></div>

    <script>
      document.documentElement.classList.add("js");

      // Hero opening boot: load-driven stagger (hero is always in viewport,
      // so scroll-reveal would just add dead delay). Delayed slightly so the
      // first frame settles before motion starts — avoids a rushed flash.
      (() => {
        const hero = document.querySelector(".term-hero");
        if (!hero) return;
        const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        if (reduce) {
          hero.classList.add("booted");
          return;
        }
        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            setTimeout(() => hero.classList.add("booted"), 150);
          });
        });
      })();

      // Scroll reveal: add .in when sections enter viewport (stagger via --i in CSS)
      (() => {
        const els = document.querySelectorAll(".reveal");
        if (!els.length) return;
        const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        if (reduce || !("IntersectionObserver" in window)) {
          els.forEach((el) => el.classList.add("in"));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add("in");
                io.unobserve(e.target);
              }
            });
          },
          { threshold: 0.08, rootMargin: "0px 0px -5% 0px" },
        );
        els.forEach((el) => io.observe(el));
      })();

      // Scroll-spy: highlight the nav link for the section in view
      (() => {
        const links = document.querySelectorAll(".nav-term__line a[data-spy]");
        if (!links.length || !("IntersectionObserver" in window)) return;
        const byId = new Map();
        links.forEach((a) => byId.set(a.getAttribute("data-spy"), a));
        const spy = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                links.forEach((a) => a.removeAttribute("aria-current"));
                const link = byId.get(e.target.id);
                if (link) link.setAttribute("aria-current", "true");
              }
            });
          },
          { rootMargin: "-40% 0px -55% 0px" },
        );
        ["work", "skills", "experience", "contact"].forEach((id) => {
          const s = document.getElementById(id);
          if (s) spy.observe(s);
        });
      })();

      // Back-to-top: reveal after scrolling past the hero
      (() => {
        const btn = document.getElementById("to-top");
        if (!btn) return;
        const onScroll = () => {
          btn.classList.toggle("show", window.scrollY > window.innerHeight * 0.8);
        };
        window.addEventListener("scroll", onScroll, { passive: true });
        onScroll();
      })();

      // Terminal toast: `[ok] copied → …` instead of swapping button text
      let toastTimer: ReturnType<typeof setTimeout> | undefined;
      function toast(msg: string) {
        const el = document.getElementById("toast");
        if (!el) return;
        el.textContent = msg;
        el.removeAttribute("aria-hidden");
        el.classList.add("show");
        clearTimeout(toastTimer);
        toastTimer = setTimeout(() => {
          el.classList.remove("show");
          el.setAttribute("aria-hidden", "true");
        }, 2600);
      }
      document.querySelectorAll("[data-copy]").forEach((btn) => {
        btn.addEventListener("click", async () => {
          const value = btn.getAttribute("data-copy") || "";
          try {
            await navigator.clipboard.writeText(value);
            toast("[ok] copied → " + (value.length > 48 ? value.slice(0, 47) + "…" : value));
          } catch {
            toast("[err] clipboard blocked — long-press to copy");
          }
        });
      });

      // Theme toggle: sync label (head script restores the saved theme pre-paint)
      (() => {
        const btn = document.getElementById("theme-btn");
        if (!btn) return;
        btn.textContent =
          "theme:" + (document.documentElement.getAttribute("data-theme") || "light");
        btn.addEventListener("click", () => {
          (window as unknown as { __cycleTheme?: () => void }).__cycleTheme?.();
          toast("[ok] theme → " + document.documentElement.getAttribute("data-theme"));
        });
      })();
    </script>
  </body>
</html>
