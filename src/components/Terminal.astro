---
import { PROFILE } from "../consts";

interface TerminalProject {
	id: string;
	title: string;
	company: string;
	metrics: string;
}

interface Props {
	projects: TerminalProject[];
	skillCats: string[];
	expCount: number;
}

const { projects, skillCats, expCount } = Astro.props;

const projectsJson = JSON.stringify(projects);
const skillsJson = JSON.stringify(skillCats);
---

<figure class="term-frame" aria-label="Interactive terminal">
  <div class="term-frame__label" aria-hidden="true">
    <span>dathx@edge: ~</span><span>utf-8 · bash</span>
  </div>
  <div class="term-frame__body">
    <div id="term-log" role="log" aria-live="polite" aria-label="Terminal output"></div>
    <form id="term-form" class="term-inputrow" autocomplete="off">
      <span class="p" aria-hidden="true">&gt;</span>
      <label class="visually-hidden" for="term-input">Terminal command input</label>
      <input
        id="term-input"
        class="term-input"
        name="cmd"
        type="text"
        spellcheck="false"
        autocapitalize="off"
        placeholder="type `help`"
        aria-describedby="term-hint"
      />
    </form>
    <p class="term-hint" id="term-hint">commands: <button type="button" class="term-hint__btn" data-run="help"><kbd>help</kbd></button> <button type="button" class="term-hint__btn" data-run="whoami"><kbd>whoami</kbd></button> <button type="button" class="term-hint__btn" data-run="projects"><kbd>projects</kbd></button> <button type="button" class="term-hint__btn" data-run="skills"><kbd>skills</kbd></button> <button type="button" class="term-hint__btn" data-run="contact"><kbd>contact</kbd></button> <button type="button" class="term-hint__btn" data-run="clear"><kbd>clear</kbd></button> · ↑/↓ history · tab complete</p>
  </div>
</figure>

<script define:vars={{ projectsJson, skillsJson, profileName: PROFILE.name, profileRole: PROFILE.role, profileEmail: PROFILE.email, profilePhone: PROFILE.phone, expCount, projectCount: projects.length, skillCount: skillCats.length }}>
  const log = document.getElementById("term-log");
  const form = document.getElementById("term-form");
  const input = document.getElementById("term-input");
  const projects = JSON.parse(projectsJson);
  const skillCats = JSON.parse(skillsJson);
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const history = [];
  let hIndex = -1;

  function esc(s) {
    return s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
  }
  function printLine(cmd, html, cls, scroll) {
    const p = document.createElement("p");
    p.className = "term-line " + (cls || "term-out");
    if (cmd !== null) {
      const echo = document.createElement("span");
      echo.innerHTML = '<span class="p">&gt;</span> ' + esc(cmd);
      p.appendChild(echo);
      const out = document.createElement("span");
      out.innerHTML = "<br>" + html;
      p.appendChild(out);
    } else {
      p.innerHTML = html;
    }
    log.appendChild(p);
    if (scroll) {
      p.scrollIntoView({ behavior: reduceMotion ? "auto" : "smooth", block: "nearest" });
    }
  }

  const COMMANDS = {
    help: () =>
      "whoami — identity · projects — " + projectCount + " shipped systems · skills — " + skillCount + " groups · experience — " +
      expCount + " roles · contact — email + phone · clear — wipe scrollback",
    whoami: () => esc(profileName) + '<br><span class="dim">' + esc(profileRole) + "</span>",
    projects: () => projects.map((p) => esc(p.id) + " · " + esc(p.title)).join("<br>"),
    skills: () => skillCats.map((c) => esc(c)).join("<br>"),
    experience: () => expCount + " roles · 2022 → present · see #experience below",
    contact: () => esc(profileEmail) + " · " + esc(profilePhone),
    hire: () => 'good call. email <span class="dim">' + esc(profileEmail) + "</span> — replies within 48h.",
    sudo: () => "permission denied: you are a guest, not root.",
  };

  function run(raw) {
    const cmd = raw.trim().toLowerCase();
    if (!cmd) return;
    if (cmd === "clear") {
      log.innerHTML = "";
      return;
    }
    const [base, ...args] = cmd.split(/\s+/);
    if (base === "projects" && args.length > 0) {
      const found = projects.find((p) => p.id === args.join("-"));
      printLine(raw, found ? esc(found.title) + '<br><span class="dim">' + esc(found.company) + (found.metrics ? " · " + esc(found.metrics) : "") + "</span>" : "unknown project id. try `projects`.", found ? "" : "term-err", true);
      return;
    }
    if (COMMANDS[base]) {
      printLine(raw, COMMANDS[base](), "", true);
    } else {
      printLine(raw, "command not found: " + esc(base) + '. try `help`.', "term-err", true);
    }
  }

  form.addEventListener("submit", (e) => {
    e.preventDefault();
    const v = input.value;
    if (v.trim()) {
      history.unshift(v);
      hIndex = -1;
    }
    run(v);
    input.value = "";
    input.focus();
  });
  // Click-to-run: hint chips execute the command for discoverability
  document.querySelectorAll("[data-run]").forEach((b) => {
    b.addEventListener("click", () => {
      run(b.getAttribute("data-run") || "");
      input.focus();
    });
  });
  input.addEventListener("keydown", (e) => {
    if (e.key === "Tab") {
      e.preventDefault();
      const val = input.value;
      const parts = val.split(/\s+/);
      // `projects <partial-id>` → complete against project ids
      if (parts.length > 1 && parts[0].toLowerCase() === "projects") {
        const frag = parts.slice(1).join("-").toLowerCase();
        const matches = projects.map((p) => p.id).filter((id) => id.startsWith(frag));
        if (matches.length === 1) {
          input.value = "projects " + matches[0];
        } else if (matches.length > 1) {
          printLine(val, matches.map((m) => esc(m)).join("<br>"), "", false);
        }
        return;
      }
      const frag = val.trim().toLowerCase();
      if (!frag) return;
      const cmds = Object.keys(COMMANDS).concat("clear");
      const matches = cmds.filter((c) => c.startsWith(frag));
      if (matches.length === 1) {
        input.value = matches[0] + " ";
      } else if (matches.length > 1) {
        printLine(val, matches.map((m) => esc(m)).join(" · "), "", false);
      }
      return;
    }
    if (e.key === "ArrowUp") {
      e.preventDefault();
      if (hIndex < history.length - 1) {
        hIndex += 1;
        input.value = history[hIndex] || "";
      }
    } else if (e.key === "ArrowDown") {
      e.preventDefault();
      if (hIndex > 0) {
        hIndex -= 1;
        input.value = history[hIndex] || "";
      } else {
        hIndex = -1;
        input.value = "";
      }
    }
  });

  const boot = ["whoami", "projects"];
  if (reduceMotion) {
    boot.forEach((c) => printLine(null, '<span class="p">&gt;</span> ' + esc(c) + "<br>" + COMMANDS[c]()));
  } else {
    // Hacker touch: type the boot commands char-by-char, then print output
    // Slow, human-paced typing — fast typing reads as jitter, not smoothness.
    function typeBoot(cmd, delay) {
      setTimeout(() => {
        const p = document.createElement("p");
        p.className = "term-line term-out";
        const echo = document.createElement("span");
        echo.innerHTML = '<span class="p">&gt;</span> ';
        const typed = document.createElement("span");
        echo.appendChild(typed);
        p.appendChild(echo);
        log.appendChild(p);
        let i = 0;
        const tick = () => {
          typed.textContent = cmd.slice(0, ++i);
          if (i < cmd.length) {
            setTimeout(tick, 90 + Math.random() * 80);
          } else {
            // Small settle pause before output appears — feels deliberate, not rushed
            setTimeout(() => {
              const out = document.createElement("span");
              out.innerHTML = "<br>" + COMMANDS[cmd]();
              p.appendChild(out);
            }, 220);
          }
        };
        tick();
      }, delay);
    }
    boot.forEach((c, i) => typeBoot(c, 1100 + i * 1400));
  }

  // Rotating placeholder hints — pauses on focus, off when reduced motion
  if (!reduceMotion) {
    const hints = ["type `help`", "try `whoami`", "try `projects`", "try `skills`", "try `contact`"];
    let hi = 0;
    setInterval(() => {
      if (document.activeElement === input || input.value) return;
      hi = (hi + 1) % hints.length;
      input.setAttribute("placeholder", hints[hi]);
    }, 3200);
  }
</script>
