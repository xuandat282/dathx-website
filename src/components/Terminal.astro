---
import { PROFILE } from "../consts";

interface TerminalProject {
  id: string;
  title: string;
  company: string;
  metrics: string;
}

interface Props {
  projects: TerminalProject[];
  skillCats: string[];
  expCount: number;
}

const { projects, skillCats, expCount } = Astro.props;

const projectsJson = JSON.stringify(projects);
const skillsJson = JSON.stringify(skillCats);
---

<figure class="term-frame" aria-label="Interactive terminal">
  <div class="term-frame__label" aria-hidden="true">
    <span>dathx@edge: ~</span>
    <span>utf-8 · bash</span>
  </div>
  <div class="term-frame__body">
    <div id="term-log" role="log" aria-live="polite" aria-label="Terminal output"></div>
    <form id="term-form" class="term-inputrow" autocomplete="off">
      <span class="p" aria-hidden="true">
        &gt;
      </span>
      <label class="visually-hidden" for="term-input">
        Terminal command input
      </label>
      <input
        id="term-input"
        class="term-input"
        name="cmd"
        type="text"
        spellcheck="false"
        autocapitalize="off"
        placeholder="type `help`"
        aria-describedby="term-hint"
      />
    </form>
    <p class="term-hint" id="term-hint">
      commands:{" "}
      <button type="button" class="term-hint__btn" data-run="help">
        <kbd>help</kbd>
      </button>{" "}
      <button type="button" class="term-hint__btn" data-run="whoami">
        <kbd>whoami</kbd>
      </button>{" "}
      <button type="button" class="term-hint__btn" data-run="projects">
        <kbd>projects</kbd>
      </button>{" "}
      <button type="button" class="term-hint__btn" data-run="skills">
        <kbd>skills</kbd>
      </button>{" "}
      <button type="button" class="term-hint__btn" data-run="theme">
        <kbd>theme</kbd>
      </button>{" "}
      <button type="button" class="term-hint__btn" data-run="contact">
        <kbd>contact</kbd>
      </button>{" "}
      <button type="button" class="term-hint__btn" data-run="clear">
        <kbd>clear</kbd>
      </button>{" "}
      · ↑/↓ history · tab complete
    </p>
  </div>
</figure>

<script
  type="module"
  define:vars={{
    projectsJson,
    skillsJson,
    profileName: PROFILE.name,
    profileRole: PROFILE.role,
    profileEmail: PROFILE.email,
    profilePhone: PROFILE.phone,
    expCount,
  }}
>
  // Single source of truth lives in /public/scripts/terminal-cmd.mjs —
  // the browser loads the same file the node --test suite covers.
  import { runCommand, completeInput, esc } from "/scripts/terminal-cmd.mjs";

  const log = document.getElementById("term-log");
  const form = document.getElementById("term-form");
  const input = document.getElementById("term-input");
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const history = [];
  let hIndex = -1;

  function ctx() {
    return {
      profileName,
      profileRole,
      profileEmail,
      profilePhone,
      projects: JSON.parse(projectsJson),
      skillCats: JSON.parse(skillsJson),
      expCount,
      currentTheme: document.documentElement.getAttribute("data-theme") || "light",
    };
  }
  function printLine(cmd, html, cls, scroll) {
    const p = document.createElement("p");
    p.className = "term-line " + (cls || "term-out");
    if (cmd !== null) {
      const echo = document.createElement("span");
      echo.innerHTML = '<span class="p">&gt;</span> ' + esc(cmd);
      p.appendChild(echo);
      const out = document.createElement("span");
      out.innerHTML = "<br>" + html;
      p.appendChild(out);
    } else {
      p.innerHTML = html;
    }
    log.appendChild(p);
    if (scroll) {
      p.scrollIntoView({ behavior: reduceMotion ? "auto" : "smooth", block: "nearest" });
    }
  }

  function run(raw) {
    const res = runCommand(raw, ctx());
    if (res.action === "ignore") return;
    if (res.action === "clear") {
      log.innerHTML = "";
      return;
    }
    if (res.action === "apply-theme") {
      /** @type {{ __setTheme?: (t: string) => void }} */
      const win = window;
      if (typeof win.__setTheme === "function") win.__setTheme(res.theme);
    }
    printLine(raw, res.html, res.cls, true);
  }

  form.addEventListener("submit", (e) => {
    e.preventDefault();
    const v = input.value;
    if (v.trim()) {
      history.unshift(v);
      hIndex = -1;
    }
    run(v);
    input.value = "";
    input.focus();
  });

  // Click-to-run: hint chips execute the command for discoverability
  document.querySelectorAll("[data-run]").forEach((b) => {
    b.addEventListener("click", () => {
      run(b.getAttribute("data-run") || "");
      input.focus();
    });
  });
  input.addEventListener("keydown", (e) => {
    if (e.key === "Tab") {
      e.preventDefault();
      const val = input.value;
      const res = completeInput(val, { projects: JSON.parse(projectsJson) });
      if (res.kind === "completed") {
        input.value = res.value;
      } else if (res.kind === "suggest") {
        printLine(val, res.items.map((m) => esc(m)).join(" · "), "", false);
      }
      return;
    }
    if (e.key === "ArrowUp") {
      e.preventDefault();
      if (hIndex < history.length - 1) {
        hIndex += 1;
        input.value = history[hIndex] || "";
      }
    } else if (e.key === "ArrowDown") {
      e.preventDefault();
      if (hIndex > 0) {
        hIndex -= 1;
        input.value = history[hIndex] || "";
      } else {
        hIndex = -1;
        input.value = "";
      }
    }
  });

  const boot = ["whoami", "projects"];
  if (reduceMotion) {
    boot.forEach((c) =>
      printLine(null, '<span class="p">&gt;</span> ' + esc(c) + "<br>" + runCommand(c, ctx()).html),
    );
  } else {
    // Hacker touch: type the boot commands char-by-char, then print output
    // Slow, human-paced typing — fast typing reads as jitter, not smoothness.
    function typeBoot(cmd, delay) {
      setTimeout(() => {
        const p = document.createElement("p");
        p.className = "term-line term-out";
        const echo = document.createElement("span");
        echo.innerHTML = '<span class="p">&gt;</span> ';
        const typed = document.createElement("span");
        echo.appendChild(typed);
        p.appendChild(echo);
        log.appendChild(p);
        let i = 0;
        const tick = () => {
          typed.textContent = cmd.slice(0, ++i);
          if (i < cmd.length) {
            setTimeout(tick, 90 + Math.random() * 80);
          } else {
            // Small settle pause before output appears — feels deliberate, not rushed
            setTimeout(() => {
              const out = document.createElement("span");
              out.innerHTML = "<br>" + runCommand(cmd, ctx()).html;
              p.appendChild(out);
            }, 220);
          }
        };
        tick();
      }, delay);
    }
    boot.forEach((c, i) => typeBoot(c, 1100 + i * 1400));
  }

  // Rotating placeholder hints — pauses on focus, off when reduced motion
  if (!reduceMotion) {
    const hints = ["type `help`", "try `whoami`", "try `projects`", "try `theme`", "try `contact`"];
    let hi = 0;
    setInterval(() => {
      if (document.activeElement === input || input.value) return;
      hi = (hi + 1) % hints.length;
      input.setAttribute("placeholder", hints[hi]);
    }, 3200);
  }
</script>
